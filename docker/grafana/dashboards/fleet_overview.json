          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "WITH seen AS (SELECT anonymous_collar_id, MAX(recorded_at) AS last_seen FROM (SELECT anonymous_collar_id, recorded_at FROM dog_metrics WHERE recorded_at > NOW() - INTERVAL '24 hours' UNION ALL SELECT anonymous_collar_id, recorded_at FROM critical_alerts WHERE recorded_at > NOW() - INTERVAL '24 hours') s GROUP BY anonymous_collar_id) SELECT COALESCE(100.0 * COUNT(*) FILTER (WHERE last_seen < NOW() - INTERVAL '10 minutes') / NULLIF(COUNT(*), 0), 0) AS pct FROM seen"
