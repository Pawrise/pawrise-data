          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT anonymous_collar_id AS collier, COUNT(*) AS alertes, MAX(recorded_at) AS derniere_alerte, MAX(bpm) AS bpm_max, MAX(temperature) AS temp_max FROM critical_alerts WHERE recorded_at > NOW() - INTERVAL '24 hours' GROUP BY anonymous_collar_id ORDER BY alertes DESC LIMIT 10"
