  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Colliers actifs (10 min)",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "timescaledb"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "timescaledb"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "WITH seen AS (SELECT anonymous_collar_id, MAX(recorded_at) AS last_seen FROM (SELECT anonymous_collar_id, recorded_at FROM dog_metrics WHERE recorded_at > NOW() - INTERVAL '24 hours' UNION ALL SELECT anonymous_collar_id, recorded_at FROM critical_alerts WHERE recorded_at > NOW() - INTERVAL '24 hours') s GROUP BY anonymous_collar_id) SELECT COUNT(*) AS actifs FROM seen WHERE last_seen >= NOW() - INTERVAL '10 minutes'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      }
    },
