          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "WITH seen AS (SELECT anonymous_collar_id, MAX(recorded_at) AS last_seen FROM (SELECT anonymous_collar_id, recorded_at FROM dog_metrics WHERE recorded_at > NOW() - INTERVAL '24 hours' UNION ALL SELECT anonymous_collar_id, recorded_at FROM critical_alerts WHERE recorded_at > NOW() - INTERVAL '24 hours') s GROUP BY anonymous_collar_id) SELECT anonymous_collar_id AS collier, last_seen AS derniere_donnee, ROUND(EXTRACT(EPOCH FROM (NOW() - last_seen)) / 60) AS minutes_de_silence FROM seen WHERE last_seen < NOW() - INTERVAL '10 minutes' ORDER BY last_seen ASC LIMIT 20"
